# ---------------------------------------------------------------------------
# Financial Services Job Intelligence POC — example environment
# Copy to `.env` and adjust. NEVER commit a real .env or any credentials.
# ---------------------------------------------------------------------------

# --- Database (SQLite by default; swap for a PostgreSQL URL later) ---
# Sync SQLAlchemy engine: persistence/analytics run synchronously inside
# Temporal activities and Streamlit. Extraction (httpx/Playwright) is async.
DATABASE_URL=sqlite:///data/app.db

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=job-intelligence

# --- Development limits (keep the POC fast and polite) ---
DEV_JOB_LIMIT=20
DEV_PAGE_LIMIT=2
HEADLESS=true
CAPTURE_DEBUG_ARTIFACTS=false

# --- HTTP / browser behaviour ---
SCRAPE_REQUEST_TIMEOUT_SECONDS=30
SCRAPE_MAX_RETRIES=3
SCRAPE_DOMAIN_CONCURRENCY=2
SCRAPE_USER_AGENT=Capgemini-FS-JobIntel-POC/0.1 (internal research; contact: fs-jobintel@example.com)

# --- Proxy (scaffolded for future production; DISABLED by default) ---
PROXY_ENABLED=false
PROXY_PROVIDER=brightdata
PROXY_ENDPOINT=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_COUNTRY=us
PROXY_SESSION_MODE=rotating
PROXY_MAX_RETRIES=2

# --- Optional LLM (DISABLED by default; app must work fully without it) ---
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
